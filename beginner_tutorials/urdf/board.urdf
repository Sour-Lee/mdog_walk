<?xml version="1.0"?>
<!--

    使用 base_footprint 优化

-->
<robot name="board">
    <!-- 设置一个原点(机器人中心点的投影) -->
    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.001" />
            </geometry>
        </visual>
    </link>

    <!-- 添加底盘 -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.2 0.2 0.5" />
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0" />
            <material name="blue">
                <color rgba="0 0 1.0 0.5" />
            </material>
        </visual>
    </link>

    <!-- 底盘与原点连接的关节 -->
    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.5" />
    </joint>


    <!-- 添加link -->
    <link name="link1">
        <visual>
            <geometry>
                <box size="0.2 0.2 0.1" />
            </geometry>
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <material name="red">
                <color rgba="1 0 0 0.5" />
            </material>
        </visual>
    </link>


    <link name="link2">
        <visual>
            <geometry>
                <box size="0.2 0.2 0.1" />
            </geometry>
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <material name="white">
                <color rgba="1 1 0 0.5" />
            </material>
        </visual>
    </link>

    <link name="plate">
        <visual>
            <geometry>
                <box size="2 2 0.05" />
            </geometry>
            <origin xyz="0 0 0.025" rpy="0 0 0" />
            <material name="white">
                <color rgba="1 0 0 0.5" />
            </material>
        </visual>
    </link>
    

    <!-- 关节 -->
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1" />
        <origin xyz="0 0 0.5" rpy="0 0 0" />
        <limit effort="300" lower="-0.18" upper="0.18" velocity="1"/>
        <axis xyz="0 1 0" />
    </joint>

    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2" />
        <origin xyz="0 0 0.1" rpy="0 0 0" />
        <limit effort="300" lower="-0.18" upper="0.18" velocity="1"/>
        <axis xyz="1 0 0" />
    </joint>


    <joint name="joint3" type="fixed">
        <parent link="link2"/>
        <child link="plate" />
        <origin xyz="0 0 0.1" rpy="0 0 0" />
        <limit effort="300" lower="-0.26" upper="0.26" velocity="1"/>
        <axis xyz="1 0 0" />
    </joint>
</robot>

