<?xml version="1.0"?>

<launch>
    <!-- lidar -->
    <include file="$(find ncu_mdog)/launch/project_sample.launch" />

    <!-- tracking -->
    <node name="listener" pkg="beginner_tutorials" type="main.py" output="screen">
    </node>
    
    <!-- servo control -->
    <include file="$(find mdog_walk)/launch/servos_control.launch" />

    <!-- walk -->
    <node name="servos_angle_publisher" pkg="mdog_walk" type="walk_forward.py" output="screen"/>
</launch>
